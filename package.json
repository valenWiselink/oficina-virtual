{
  "name": "pixel-agents",
  "displayName": "Oficina virtual",
  "description": "Tus agentes de Claude Code en una oficina: quién te necesita, quién trabaja y qué hacen",
  "version": "1.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-agents-hq/pixel-agents"
  },
  "workspaces": [
    "server",
    "webview-ui"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pixel-agents": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist/cli.js",
    "dist/hooks/claude-hook.js",
    "dist/assets/",
    "dist/webview/"
  ],
  "scripts": {
    "build:webview": "cd webview-ui && npm run build",
    "compile": "npm run asyncapi:generate && npm run check-types && npm run lint && node esbuild.js && npm run build:webview",
    "build": "npm run compile",
    "build:app": "node esbuild.js --production && npm run build:webview",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run asyncapi:generate && npm run check-types && npm run lint && node esbuild.js --production && npm run build:webview",
    "asyncapi:generate": "tsx scripts/generate-messages.ts",
    "asyncapi:validate": "node scripts/validate-asyncapi.mjs",
    "check-types": "tsc --noEmit && tsc --noEmit -p server/tsconfig.test.json && tsc -p desktop/tsconfig.json",
    "prepare": "husky",
    "lint": "eslint server core desktop && cd webview-ui && eslint .",
    "lint:fix": "eslint server core --fix && cd webview-ui && eslint . --fix",
    "format": "prettier --write \"server/**/*.ts\" \"core/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"core/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "test:webview": "cd webview-ui && npm test",
    "test:server": "cd server && npm test",
    "test": "npm run test:webview && npm run test:server",
    "knip": "knip",
    "build:desktop": "esbuild desktop/main.ts desktop/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --minify --outdir=dist-desktop",
    "desktop": "npm run build:desktop && electron .",
    "pack:win": "npm run build:app && npm run build:desktop && electron-builder --win --dir",
    "dist:win": "npm run build:app && npm run build:desktop && electron-builder --win"
  },
  "devDependencies": {
    "@asyncapi/modelina": "^5.10.1",
    "@asyncapi/parser": "^3.6.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "26.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.105.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^3.1.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^16.3.2",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "semver": "^7.8.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "server/**/*.ts": "eslint --fix",
    "core/src/**/*.ts": "eslint --fix",
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "scripts/**/*.{js,mjs}": "prettier --write",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write",
    "webview-ui/**/*.{ts,tsx,js,css,json}": "prettier --write"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "fastify": "^5.8.5"
  },
  "overrides": {
    "jsonpath-plus": "^10.4.0",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.1.1",
    "json-schema-migrate": {
      "ajv": "^6.15.0"
    },
    "webapi-parser": {
      "ajv": "^6.15.0"
    }
  },
  "main": "dist-desktop/main.js"
}
