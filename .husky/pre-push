#!/bin/sh
set -e

echo "🔍 Type-checking..."
npm run check-types

# Catch generated-file drift: regenerate the AsyncAPI bindings and fail if
# they differ from what's committed (then just commit them and push again).
echo "🔍 Checking generated-file drift (AsyncAPI bindings)..."
npm run asyncapi:generate
if ! git diff --exit-code core/src/messages.ts; then
  echo "❌ core/src/messages.ts was out of date and has been regenerated above."
  echo "   Commit it, then push again."
  exit 1
fi
